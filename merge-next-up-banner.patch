+// one banner and one pop-out list covering both. Results to log lead the
+// headline (they need an actual decision — a score to enter — so they're
+// the more urgent of the two) with upcoming fixtures filling in behind
+// them; the badge counts both together. Renders nothing when there's
+// truly nothing waiting, so it never leaves an empty band above the Shop
+// banner.
+function NextUpBar({ resultItems, fixtures, onOpen, c }) {
+  const total = (resultItems?.length || 0) + (fixtures?.length || 0);
+  if (total === 0) return null;
+  const urgent = resultItems.length > 0;
+  const leading = urgent
+    ? { label: resultItems.length > 1 ? "Results to log" : "Result to log", opponent: resultItems[0].opponentUsername, meta: resultItems.length > 1 ? `${resultItems.length} matches waiting` : null }
