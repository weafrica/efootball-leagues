-.animate-glow-drift { animation: glow-drift 7s ease-in-out infinite; }
+.animate-glow-drift { animation: glow-drift 7s ease-in-out infinite; }
+
+/* Join button — a deliberately louder CTA than every other button in the
+   app: its own fixed sunset-gold gradient (independent of the active
+   theme's accent, so it reads the same and still pops in both light and
+   dark mode) rather than the flat theme-accent fill every other button
+   uses, a condensed display font in place of the usual body/mono, and a
+   soft glow that breathes so it draws the eye without flashing. Kept as
+   a CSS class (not inline style) since the gradient/animation/font-family
+   trio doesn't vary per-theme the way background/color do elsewhere —
+   callers still set color inline for contrast against the gradient. */
+.btn-join {
+  font-family: 'Barlow Condensed', 'Oswald', sans-serif;
+  background: linear-gradient(135deg, #FFD166 0%, #D4A017 55%, #FF7A00 100%);
+  text-transform: uppercase;
+  letter-spacing: 0.07em;
+  transition: transform 0.15s ease, box-shadow 0.15s ease, filter 0.15s ease;
+  animation: join-btn-glow 2.6s ease-in-out infinite;
+}
+.btn-join:hover { transform: translateY(-1px) scale(1.03); filter: brightness(1.08); }
+.btn-join:active { transform: translateY(0) scale(0.96); filter: brightness(0.97); }
+
+@keyframes join-btn-glow {
+  0%, 100% { box-shadow: 0 0 0 0 rgba(212,160,23,0), 0 2px 6px rgba(0,0,0,0.18); }
+  50% { box-shadow: 0 0 16px 4px rgba(212,160,23,0.6), 0 2px 10px rgba(0,0,0,0.22); }
+}
 
