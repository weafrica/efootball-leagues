+
+// ─────────────────────────────────────────────────────────────────────────
+// Buy Nets — a standalone top-up (see nets_purchases in
+// supabase/migrations/20260843_secure_grants_and_nets_purchases.sql), not
+// tied to any league. Same two payment options as a cash league entry:
+// iKhokha card (instant, auto-credited via the ikhokha-webhook edge
+// function) or bank transfer / Mukuru (manual proof upload, admin
+// approves via approve_nets_purchase).
+//
+// Pricing: 1 Net per Rand — a flat, easy-to-reason-about rate (R10 = 10
+// Nets). Bigger top-ups get a transparent bonus on top of that (no fine
+// print, no expiry) rather than a better "secret" rate, so the on-screen
+// number is always the real number.
+// ─────────────────────────────────────────────────────────────────────────
+export const NETS_PER_RAND = 1;
+
+export function netsBonusPct(randAmount) {
+  if (randAmount >= 200) return 0.10;
+  if (randAmount >= 100) return 0.05;
+  return 0;
+}
+
+export function netsForRand(randAmount) {
+  const base = Math.round(Number(randAmount) || 0) * NETS_PER_RAND;
+  return Math.round(base * (1 + netsBonusPct(randAmount)));
+}
+
+// Uploads proof of payment for a manual (bank transfer / Mukuru) Nets
+// top-up and creates the pending purchase row. Mirrors joinCashLeague's
+// shape in App.jsx, but for a standalone top-up with no league attached —
+// crediting only happens once an admin approves it via approveNetsPurchase.
+export async function submitNetsPurchaseProof(randAmount, file) {
+  const { data: { session } } = await supabase.auth.getSession();
+  const uid = session?.user?.id;
+  if (!uid) throw new Error("You need to be signed in to buy Nets.");
+
+  const netsAmount = netsForRand(randAmount);
+  const ext = (file.name.split(".").pop() || "dat").toLowerCase();
+  const path = `${uid}/nets-${Date.now()}.${ext}`;
+
+  const { error: uploadErr } = await supabase.storage
+    .from("payment-proofs")
+    .upload(path, file, { cacheControl: "31536000" });
+  if (uploadErr) throw uploadErr;
+
+  const { data, error } = await supabase
+    .from("nets_purchases")
+    .insert({
+      user_id: uid, rand_amount: randAmount, nets_amount: netsAmount,
+      payment_status: "pending", payment_method: "bank_transfer", payment_proof_path: path,
+    })
+    .select()
+    .single();
+  if (error) throw error;
+  return data;
+}
+
+// Starts a card top-up: creates the pending purchase row, then asks the
+// create-nets-payment edge function for an iKhokha checkout link. Same
+// two-step shape as handlePayByCard in App.jsx for cash league entries,
+// just pointed at nets_purchases instead of members. Returns the checkout
+// URL — the caller is responsible for redirecting to it.
+export async function startNetsPurchaseByCard(randAmount) {
+  const { data: { session } } = await supabase.auth.getSession();
+  if (!session) throw new Error("You need to be signed in to buy Nets.");
+
+  const netsAmount = netsForRand(randAmount);
+  const { data: purchase, error } = await supabase
+    .from("nets_purchases")
+    .insert({ user_id: session.user.id, rand_amount: randAmount, nets_amount: netsAmount, payment_status: "pending" })
+    .select()
+    .single();
+  if (error) throw error;
+
+  const response = await fetch(
+    "https://jobgzxljuczzqljwavyq.supabase.co/functions/v1/create-nets-payment",
+    {
+      method: "POST",
+      headers: { "Content-Type": "application/json", Authorization: `Bearer ${session.access_token}` },
+      body: JSON.stringify({ purchase_id: purchase.id }),
+    }
+  );
+
+  const data = await response.json();
+  if (!response.ok) throw new Error(data.error || "Couldn't start card payment. Please try again.");
+  return data.paylinkUrl;
+}
+
+// Pending Nets purchases awaiting admin review, oldest first, each
+// annotated with the buyer's display name for the admin review list.
+// nets_purchases only stores user_id, so this does a second query for
+// profiles rather than relying on a PostgREST embed (no direct FK between
+// the two tables) and merges client-side.
+export async function getPendingNetsPurchases() {
+  const { data: purchases, error } = await supabase
+    .from("nets_purchases")
+    .select("*")
+    .eq("payment_status", "pending")
+    .order("created_at", { ascending: true });
+  if (error) throw error;
+  if (!purchases?.length) return [];
+
+  const userIds = [...new Set(purchases.map((p) => p.user_id))];
+  const { data: profiles } = await supabase.from("profiles").select("user_id, efootball_username").in("user_id", userIds);
+  const nameByUser = Object.fromEntries((profiles || []).map((p) => [p.user_id, p.efootball_username]));
+  return purchases.map((p) => ({ ...p, buyer_name: nameByUser[p.user_id] || "Unknown player" }));
+}
+
+// Admin-only — credits the wallet and flips the purchase to approved
+// server-side (see approve_nets_purchase in the migration). Throws
+// "admin only" if called by anyone else; RLS/the RPC's own check is the
+// real backstop, this is just where the client finds out.
+export async function approveNetsPurchase(purchaseId) {
+  const { error } = await supabase.rpc("approve_nets_purchase", { p_purchase_id: purchaseId });
+  if (error) throw error;
+}
+
+// Admin-only — marks a purchase rejected without crediting anything.
+export async function rejectNetsPurchase(purchaseId) {
+  const { error } = await supabase.rpc("reject_nets_purchase", { p_purchase_id: purchaseId });
+  if (error) throw error;
+}
+
+// Admin/creator only — downloads a Nets purchase's proof of payment via a
+// short-lived signed URL, same pattern as downloadPaymentProof in App.jsx.
+export async function downloadNetsPurchaseProof(path) {
+  if (!path) throw new Error("No proof of payment on file for this purchase.");
+  const { data, error } = await supabase.storage.from("payment-proofs").createSignedUrl(path, 120);
+  if (error || !data) throw error || new Error("Couldn't generate a download link.");
+  return data.signedUrl;
+}
+
+// Whether the given (or signed-in) user is a site admin — used to decide
+// whether NetsPanel shows the "pending purchases" review section. Kept
+// here rather than threaded down as a prop from App.jsx so NetsPanel stays
+// fully self-contained, consistent with how it already fetches its own
+// balance/history.
+export async function isSiteAdmin(userId) {
+  let uid = userId;
+  if (!uid) {
+    const { data: { session } } = await supabase.auth.getSession();
+    uid = session?.user?.id;
+  }
+  if (!uid) return false;
+  const { data } = await supabase.from("admins").select("user_id").eq("user_id", uid).maybeSingle();
+  return !!data;
+}
